+def build_synthetic_weekly_slot_catalog(
+    *,
+    identity: str,
+    version: str,
+    weekly_capacity: int,
+    deadline_policy_identity: str,
+    deadline_policy_version: str,
+    assignment_deadlines: tuple[tuple[str, int], ...],
+    week_indices: tuple[int, ...],
