+        identity,
+        version,
+        weekly_capacity,
+        deadline_policy_identity,
+        deadline_policy_version,
+        tuple(generated),
+        pattern.course_start_weekday_iso,
+    )
+    return catalog, tuple(
+        (assignment_id, tuple(sorted(eligible[assignment_id])))
+        for assignment_id in identities
+    )
