# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and local configuration
.venv/
venv/
.env
.env.*
!.env.example

# Raw data - keep local
data/raw/*
!data/raw/.gitkeep

# Processed data - ignore by default
data/processed/*
!data/processed/.gitkeep

# Required feature datasets
!data/processed/strict/
!data/processed/proxy/

# Required trained model artifacts
!data/processed/nn_experiment/
!data/processed/nn_experiment_60ep/
!data/processed/nn_experiment_previous_marks/

# Generated figures
reports/figures/*
!reports/figures/.gitkeep
